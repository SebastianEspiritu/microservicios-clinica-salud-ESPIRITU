<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM agregador: solo sirve para que IntelliJ importe todos los proyectos
  de una sola vez al abrir la carpeta "microservicios".
  Cada microservicio sigue siendo un proyecto Spring Boot independiente.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tecsup</groupId>
    <artifactId>microservicios</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>microservicios</name>

    <modules>
        <module>eureka-server</module>
        <module>cliente-service</module>
        <module>categoria-service</module>
        <module>producto-service</module>
        <module>pedido-service</module>
        <module>paciente-service</module>
        <module>medico-service</module>
        <module>cita-service</module>
    </modules>
</project>
